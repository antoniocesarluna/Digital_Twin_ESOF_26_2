{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemeo-campus.example/schemas/1.0.0/comum.schema.json",
  "title": "Campus Domain — Value Objects comuns",
  "$defs": {
    "Identificador": {
      "type": "string",
      "description": "IRI estável do objeto urbano (RN-01).",
      "pattern": "^urn:upm:campus-hig:(edificacao|pavimento|via|poi|area-verde|campus):[a-z0-9-]+$"
    },
    "NumeroMapa": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "description": "Número do objeto no mapa oficial do campus."
    },
    "Crs": {
      "const": "EPSG:31983",
      "description": "SIRGAS 2000 / UTM 23S (RN-10)."
    },
    "Posicao": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 3
    },
    "Ponto": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/Posicao"
        }
      }
    },
    "LinhaPoligonal": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Posicao"
          }
        }
      }
    },
    "Poligono": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/Posicao"
            }
          }
        }
      }
    },
    "Endereco": {
      "type": "object",
      "required": [
        "logradouro",
        "numero"
      ],
      "additionalProperties": false,
      "properties": {
        "logradouro": {
          "type": "string",
          "minLength": 3
        },
        "numero": {
          "type": "string",
          "pattern": "^[0-9]+[A-Za-z]?$"
        },
        "complemento": {
          "type": "string"
        },
        "municipio": {
          "const": "São Paulo"
        },
        "uf": {
          "const": "SP"
        }
      }
    },
    "Situacao": {
      "enum": [
        "ativo",
        "planejado",
        "em-obra",
        "desativado"
      ]
    },
    "DataHora": {
      "type": "string",
      "description": "Data e hora ISO 8601 com fuso.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Metadados": {
      "type": "object",
      "required": [
        "versao"
      ],
      "additionalProperties": false,
      "properties": {
        "versao": {
          "type": "integer",
          "minimum": 1,
          "description": "Versão do objeto (RF14); incrementa a cada alteração."
        },
        "atualizadoEm": {
          "$ref": "#/$defs/DataHora"
        },
        "alteradoPor": {
          "type": "string",
          "description": "Usuário com perfil de gestor que fez a alteração (auditoria)."
        },
        "fonte": {
          "type": "string"
        }
      }
    }
  }
}
