{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemeo-campus.example/schemas/1.0.0/vocabulario.schema.json",
  "title": "Vocabulário controlado do Campus Domain (consumo obrigatório pelo G5)",
  "type": "object",
  "required": [
    "vocabulario",
    "versao",
    "usadoEm",
    "termos"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "vocabulario": {
      "type": "string"
    },
    "versao": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "usadoEm": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "termos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "codigo",
          "rotulo",
          "definicao"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "rotulo": {
            "type": "string",
            "minLength": 2
          },
          "definicao": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
